{
  "description": "Once a day, refresh the dashboard in the background at session start; warn about large or expired contexts before prompts.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\"; exit 0",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/nudge.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/nudge.py\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}